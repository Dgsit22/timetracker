<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="TimeTracker Agent"
           Manufacturer="DigiClarity"
           Version="1.0.0.0"
           UpgradeCode="6f6b1a1a-6e6c-4f7f-9b1b-7a1a2b3c4d5e"
           Compressed="yes"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of TimeTracker Agent is already installed."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!--
      SERVERURL/AGENTAPIKEY can be set two ways:
        - GUI install (double-click the MSI, or `msiexec /i`): a wizard page (ServerConfigDlg,
          below) prompts for both before Install.
        - Silent install (push deployment): `msiexec /i ... /qn SERVERURL=... AGENTAPIKEY=...`
          skips all UI, so the wizard page never shows - these Property defaults/values are
          used as-is.
    -->
    <Property Id="SERVERURL" Value="http://localhost:5081" />
    <Property Id="AGENTAPIKEY" Secure="yes" />

    <ui:WixUI Id="WixUI_Minimal" />

    <UI>
      <!--
        Show ServerConfigDlg as the very first screen, ahead of the stock Welcome/EULA/Install
        dialog. Two earlier approaches both failed silently:
          1. Publishing WelcomeDlg->Next->NewDialog=ServerConfigDlg: WiX 5's WixUI_Minimal entry
             dialog is actually WelcomeEulaDlg (merged Welcome+EULA), not the old WelcomeDlg -
             confirmed via `msiexec /l*v`, which logs "Skipping action: WelcomeDlg (condition is
             false)".
          2. Publishing WelcomeEulaDlg->Next->NewDialog=ServerConfigDlg: WelcomeEulaDlg has no
             "Next" control at all (confirmed via the compiled MSI's Control table) - its only
             forward button is "Install", which fires EndDialog=Return directly and ends the whole
             UI sequence, so a ControlEvent on a nonexistent "Next" control never fires.
        Scheduling our own dialog directly in InstallUISequence, ahead of the library's ("NOT
        Installed" matches its own condition on WelcomeEulaDlg, so it's skipped the same way on a
        repair/maintenance run), sidesteps both: WelcomeEulaDlg itself is never touched, so its
        Install button keeps working exactly as WiX authored it once our page hands off to it.
      -->
      <InstallUISequence>
        <Show Dialog="ServerConfigDlg" Before="WelcomeEulaDlg" Condition="NOT Installed" />
      </InstallUISequence>

      <Publish Dialog="ServerConfigDlg" Control="Next" Event="NewDialog" Value="WelcomeEulaDlg" Order="1" Condition="1" />

      <Dialog Id="ServerConfigDlg" Width="370" Height="270" Title="TimeTracker Agent Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Server connection" />
        <Control Id="Description" Type="Text" X="15" Y="32" Width="340" Height="24" Transparent="yes" NoPrefix="yes" Text="Enter the TimeTracker server this Agent should send activity reports to." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="ServerUrlLabel" Type="Text" X="20" Y="70" Width="330" Height="15" NoPrefix="yes" Text="Server URL (e.g. http://192.168.0.15:5081):" />
        <Control Id="ServerUrlEdit" Type="Edit" X="20" Y="86" Width="330" Height="18" Property="SERVERURL" />

        <Control Id="ApiKeyLabel" Type="Text" X="20" Y="114" Width="330" Height="15" NoPrefix="yes" Text="Agent API key:" />
        <Control Id="ApiKeyEdit" Type="Edit" X="20" Y="130" Width="330" Height="18" Property="AGENTAPIKEY" />

        <Control Id="HintText" Type="Text" X="20" Y="156" Width="330" Height="60" Transparent="yes" NoPrefix="yes" Text="Both values must match this server's deployment: the URL it's reachable at, and the AGENT_API_KEY set in its .env file. Ask your administrator if you're not sure." />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TimeTracker Agent" />
    </StandardDirectory>

    <!--
      Runs per-user from the all-users Startup folder, not as a LocalSystem service: a
      Windows Service runs in Session 0, which has no interactive desktop, so foreground
      window detection, idle detection, and screen capture all silently return nothing
      useful there. Every user who logs into this machine gets their own Agent instance
      launched at logon, with normal desktop access.
      WiX 5's StandardDirectory whitelist has no all-users Startup entry, only the
      per-user one, so it's built manually under CommonAppDataFolder (ProgramData).
    -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Name="Microsoft">
        <Directory Name="Windows">
          <Directory Name="Start Menu">
            <Directory Name="Programs">
              <Directory Id="CommonStartupFolder" Name="StartUp" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="TimeTracker Agent" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="TimeTracker Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="AgentExeComponent" />
      <ComponentRef Id="StartupShortcutComponent" />
      <ComponentRef Id="TroubleshooterShortcutComponent" />
      <ComponentRef Id="SettingsShortcutComponent" />
    </Feature>

    <!-- Everything except the exe, which gets its own component below (KeyPath for the write-config custom action). -->
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\TimeTracker.Agent.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="AgentExeComponent" Directory="INSTALLFOLDER" Guid="8d6e6f5a-1234-4a2b-9c3d-1a2b3c4d5e6f">
      <File Id="AgentExe" Source="$(var.PublishDir)\TimeTracker.Agent.exe" KeyPath="yes" />
    </Component>

    <Component Id="StartupShortcutComponent" Directory="CommonStartupFolder" Guid="3a2b1c4d-5e6f-4a1b-8c2d-9e0f1a2b3c4d">
      <Shortcut Id="StartupShortcut"
                Name="TimeTracker Agent"
                Description="Captures desktop activity and syncs it to the TimeTracker server."
                Target="[#AgentExe]"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM"
                      Key="Software\DigiClarity\TimeTracker Agent"
                      Name="StartupShortcutInstalled"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <!--
      Lets a user or admin check, at any time after install, whether this Agent can
      actually reach the server and that its API key is accepted - without digging
      through Event Viewer. Runs the same exe in its "test connection" mode, which
      hits the real authenticated endpoint SyncClient uses and reports pass/fail via
      MessageBox.
    -->
    <Component Id="TroubleshooterShortcutComponent" Directory="AppProgramMenuFolder" Guid="7c3e8f2a-4b5d-4e6f-a1b2-c3d4e5f6a7b8">
      <Shortcut Id="TroubleshooterShortcut"
                Name="Test Connection"
                Description="Checks whether this Agent can reach the TimeTracker server and that its API key is accepted."
                Target="[#AgentExe]"
                Arguments="--test-connection"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppProgramMenuFolder" Directory="AppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM"
                      Key="Software\DigiClarity\TimeTracker Agent"
                      Name="TroubleshooterShortcutInstalled"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <!--
      The Agent runs windowless, so its Settings live on the tray icon's right-click menu - which
      is effectively invisible if the icon is hidden behind the taskbar's overflow chevron (it
      routinely is). This Start Menu entry gives it a findable home alongside Test Connection,
      opening the same window via the exe's "settings" command-line mode.
    -->
    <Component Id="SettingsShortcutComponent" Directory="AppProgramMenuFolder" Guid="b41d9e7c-5a2f-4c8e-9d3b-6f0a1c2e4d59">
      <Shortcut Id="SettingsShortcut"
                Name="TimeTracker Agent Settings"
                Description="Set the TimeTracker server URL and Agent API key this machine reports to."
                Target="[#AgentExe]"
                Arguments="--settings"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM"
                      Key="Software\DigiClarity\TimeTracker Agent"
                      Name="SettingsShortcutInstalled"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <!--
      Config is delivered via a file the Agent writes to itself (agent-settings.json under
      ProgramData), not machine environment variables: those aren't visible to processes
      started before the next logon/reboot, so a freshly-installed Startup app wouldn't see
      one set during this same install. The file approach works immediately.

      WriteAgentConfig itself is deferred (it runs elevated, after files are staged), and
      deferred custom actions can't see the property table directly - [SERVERURL] and
      [AGENTAPIKEY] would resolve to blank there, silently dropping whatever the wizard
      collected. The documented fix for that is to stash the data in a same-named property
      so the engine copies it into the deferred action's reserved CustomActionData - but
      for an *EXE*-type deferred action that data doesn't actually reach the launched
      process's command line or environment (verified empirically against a compiled
      build: both `[CustomActionData]` substitution and the `%CustomActionData%`
      env var came through blank, even though the property itself was set correctly).
      So instead: StageAgentConfig (immediate, with direct property access) writes the
      pipe-joined value to a fixed temp path, and WriteAgentConfig (deferred, elevated)
      reads it back from there and deletes it - see InstallTimeConfig.cs for the full
      writeup of why CustomActionData doesn't work here.

      StageAgentConfig targets cmd.exe rather than "[#AgentExe]", even though it's
      staging data *for* the Agent exe: "After InstallFiles" only orders it after
      InstallFiles in the sequence table, but InstallFiles is itself deferred, so at the
      point this immediate action actually runs, InstallFiles has only been *scheduled*
      into the execution script, not actually run yet - the exe isn't on disk. cmd.exe
      always is (verified: targeting "[#AgentExe]" here fails instantly with Error 1721,
      "program required for this install to complete could not be run"). The `^` before
      the pipe escapes it from cmd's own parser, which would otherwise treat an
      unescaped `|` as a real pipe rather than a literal character to write out.

      Same reasoning rules out Directory="INSTALLFOLDER" as this CA's working directory:
      CreateFolders (which makes it) is deferred too, so INSTALLFOLDER doesn't exist yet
      either at this point (confirmed: with Directory="INSTALLFOLDER", even the cmd.exe
      version above still failed with the same instant Error 1721 - CreateProcess fails
      outright if the working directory doesn't exist, regardless of whether the target
      program itself is found). SystemFolder (C:\Windows\System32) is populated by the
      standard AppSearch/CostInitialize actions early in the sequence and always exists.
    -->
    <CustomAction Id="StageAgentConfig"
                  Directory="SystemFolder"
                  ExeCommand='cmd.exe /c &quot;echo [SERVERURL]^|[AGENTAPIKEY]&gt;C:\Windows\Temp\timetracker-agent-stage.tmp&quot;'
                  Execute="immediate"
                  Return="check" />

    <!--
      Paths here (and in the two actions below) are built from [INSTALLFOLDER] rather than the
      more obvious [#AgentExe] File-key token, which turns out to resolve to an empty string on
      a forced-reinstall run (REINSTALL=ALL REINSTALLMODE=amus): [#FileKey] only expands once
      that file's component has an *install* action state, and a reinstall computes component
      states differently. The failure mode is nasty - the program half of the ExeCommand silently
      collapses to an empty `""`, so CreateProcess has no program to launch and the install dies
      with a generic "a program required for this install to complete could not be run" (1721),
      pointing at nothing in particular. A plain /i install resolves it fine, so this only bites
      on repair/forced-reinstall - exactly the path used to push an updated build to a machine.
      [INSTALLFOLDER] is a directory property resolved at CostFinalize and always populated, and
      it already carries its trailing backslash.
    -->
    <CustomAction Id="WriteAgentConfig"
                  Directory="INSTALLFOLDER"
                  ExeCommand='&quot;[INSTALLFOLDER]TimeTracker.Agent.exe&quot; --write-staged-config'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Without this, a repair/upgrade install leaves the Agent stopped until the next logon:
      Windows' Restart Manager silently closes the running TimeTracker.Agent.exe mid-install
      so the MSI can overwrite the locked exe, and nothing brings it back - the Startup-folder
      shortcut only fires at logon, which may not happen again for the rest of that session.
      Scheduled "immediate" (not deferred) so it runs inside the installer's own process, which
      stays in the interactive user's session even when UAC-elevated - unlike a deferred action,
      which always executes in the separate, Session-0-bound msiexec service process and could
      never attach a tray icon or see the desktop.
      Return="asyncNoWait", not "ignore" - found the hard way, by actually running a genuine
      fresh install (every earlier test happened to have an old instance already running, so
      the launch immediately lost the single-instance mutex race and exited in milliseconds,
      masking this): "ignore" still launches the exe *synchronously* and just ignores its exit
      code, but the Agent is a long-running background service that never exits on its own - so
      on a real fresh install (nothing previously running to lose the mutex race), the installer
      sat there waiting forever for a process that was never going to return, wedging InstallFinalize
      indefinitely with no error, just an OS "not responding" dialog. asyncNoWait launches it and
      moves on immediately, which is all this was ever meant to do.
      A silent/unattended install (e.g. pushed via RMM under a service account with no interactive
      session) has nothing to attach to; the exe still autostarts at the next real logon via the
      Startup shortcut either way, so this remains a best-effort convenience, not load-bearing.
      Guarded against uninstall so it doesn't try to relaunch an exe InstallFinalize just deleted.
    -->
    <CustomAction Id="LaunchAgentAfterInstall"
                  Directory="INSTALLFOLDER"
                  ExeCommand='&quot;[INSTALLFOLDER]TimeTracker.Agent.exe&quot;'
                  Execute="immediate"
                  Return="asyncNoWait" />

    <!--
      Covers what LaunchAgentAfterInstall can't: a crash, a kill from Task Manager/AV, or a
      reboot where nobody happens to log back in right at logon (auto-login races, a machine
      left at the lock screen for a while, etc). Task Scheduler - not a Windows Service, for the
      same Session-0-has-no-desktop reason as everything else here - polls every 5 minutes and
      relaunches the exe if it isn't running. Safe to fire even when it's already running: the
      Agent's own single-instance mutex (see Program.cs) makes the redundant launch an instant
      no-op, so there's no risk of doubled-up trackers.
      /RU Users /IT (not a specific username): runs in whichever interactive user's session is
      actually logged on at each 5-minute tick, matching the Startup shortcut's existing
      per-user model, rather than hardcoding the one account that happened to run the installer -
      untested against an actual second concurrent user on this machine, so verify that path
      before relying on it for a genuinely multi-user box.
      /TR needs the doubled-quote form (/TR "\"C:\...\TimeTracker.Agent.exe\""), confirmed against
      this machine's actual schtasks.exe by inspecting the created task's raw XML (`schtasks /Query
      /XML`) - the friendly `/V /FO LIST` display recombines Command+Arguments either way, so it
      doesn't actually prove the quoting worked. An earlier single-quoted version (/TR "...") looked
      fine in that display but the raw XML showed schtasks had silently split it at the first space
      - <Command>C:\Program</Command><Arguments>Files\...\TimeTracker.Agent.exe</Arguments> - which
      then failed at run time with ERROR_FILE_NOT_FOUND (0x80070002). The doubled-quote form's raw
      XML confirmed a single, correctly-quoted <Command> with no stray <Arguments>.
      Return="ignore" and /F (overwrite) for the same best-effort, idempotent-on-repair reasoning
      as LaunchAgentAfterInstall above.
    -->
    <CustomAction Id="CreateWatchdogTask"
                  Directory="SystemFolder"
                  ExeCommand='schtasks.exe /Create /TN &quot;TimeTracker Agent Watchdog&quot; /TR &quot;\&quot;[INSTALLFOLDER]TimeTracker.Agent.exe\&quot;&quot; /SC MINUTE /MO 5 /RU Users /IT /RL LIMITED /F'
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="RemoveWatchdogTask"
                  Directory="SystemFolder"
                  ExeCommand='schtasks.exe /Delete /TN &quot;TimeTracker Agent Watchdog&quot; /F'
                  Execute="immediate"
                  Return="ignore" />

    <!--
      Conditions below deliberately test REINSTALL/UPGRADINGPRODUCTCODE alongside REMOVE, rather
      than the obvious-looking REMOVE~="ALL" on its own. A forced reinstall
      (REINSTALL=ALL REINSTALLMODE=amus - how an updated build gets pushed onto a machine that
      already has one) sets REMOVE="ALL" *too*, because MSI models a reinstall as removing every
      feature and re-adding it. With the naive conditions that inverted this whole block: the
      watchdog task got deleted, and both the launch and the re-create were skipped, while the
      install still cheerfully reported "completed successfully" - verified in an /l*v log, which
      showed "Adding REMOVE property. Its value is 'ALL'" followed by "Skipping action:
      LaunchAgentAfterInstall (condition is false)".
      A genuine uninstall is the case where REMOVE="ALL" *and* REINSTALL is empty; the extra
      UPGRADINGPRODUCTCODE test keeps the old version's removal half of a major upgrade from
      tearing down the task the new version just registered.
    -->
    <InstallExecuteSequence>
      <!-- Both run the installed exe, so both must run after it's actually on disk. -->
      <!--
        "NOT Installed" alone is not enough to mean "first install": a forced reinstall clears
        Installed too, so these fired on a reinstall and rewrote agent-settings.json from the
        property defaults - resetting ServerBaseUrl to the localhost placeholder and dropping the
        configured AgentApiKey entirely (observed: a working config reduced to just the default
        URL). The wizard never runs on a reinstall, so there are no real values to write there.
      -->
      <Custom Action="StageAgentConfig" After="InstallFiles" Condition="NOT Installed AND NOT REINSTALL" />
      <Custom Action="WriteAgentConfig" After="StageAgentConfig" Condition="NOT Installed AND NOT REINSTALL" />
      <Custom Action="LaunchAgentAfterInstall" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot; OR REINSTALL" />
      <Custom Action="CreateWatchdogTask" After="LaunchAgentAfterInstall" Condition="NOT REMOVE~=&quot;ALL&quot; OR REINSTALL" />
      <Custom Action="RemoveWatchdogTask" After="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND NOT REINSTALL AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
