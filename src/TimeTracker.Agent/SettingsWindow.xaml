<Window x:Class="TimeTracker.Agent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TimeTracker Agent - Settings"
        Width="1010" Height="820" MinWidth="880" MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFF0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <!--
          Content runs under the title bar so the window reads as one pane of glass. The caption
          buttons stay native: reimplementing minimise, maximise and close also means
          reimplementing snap layouts, the system menu and their accessibility behaviour.
        -->
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>

    <!--
      Three colours, and the contrast maths decides what each one may do:
        rust   #8C381F  7.71:1 on ivory - text, headings, icons, primary fill
        orange #FB9824  a filled surface only; ivory text on it is 2.16:1
        ivory  #FFFFF0  the canvas

      One deviation from the brief, and it is deliberate: rust on orange measures
      3.56:1, which passes for large text and UI shapes but not for a 14px button
      label. Where text sits on orange it uses OnAccentBrush - the same hue pressed
      darker to 4.73:1 - so the look is what was asked for and the contrast rule the
      same brief sets is still met.

      Palette matches the Server console (site.css :root), so the two read as one
      product. There is no realistic way for a WPF app and a Razor site to share a
      token file, so a change there needs a matching edit here.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFF0" />

        <!--
          Glass surfaces. The window itself is transparent so DWM's acrylic shows through; these
          sit on top of it. Alpha is deliberately high - E6 is 90%, D9 is 85% - because acrylic
          samples whatever is behind the window, and a thinner surface would drag a desktop
          wallpaper up under the text. At these values rust stays above 6:1 on any backdrop.
        -->
        <SolidColorBrush x:Key="GlassSidebarBrush" Color="#D9FFFFF0" />
        <SolidColorBrush x:Key="GlassCardBrush" Color="#E8FFFFFF" />
        <SolidColorBrush x:Key="GlassFieldBrush" Color="#F2FFFFF0" />
        <SolidColorBrush x:Key="GlassStatusBrush" Color="#E6FFF7E8" />
        <SolidColorBrush x:Key="GlassHairlineBrush" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#E7DCCF" />
        <SolidColorBrush x:Key="RustBrush" Color="#8C381F" />
        <SolidColorBrush x:Key="RustHoverBrush" Color="#732D18" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#6F2B16" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FB9824" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#F08C14" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF0D8" />
        <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#FFF7E8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B5145" />
        <SolidColorBrush x:Key="DangerBrush" Color="#A32F22" />


        <!-- ============================ Icons ============================ -->
        <Geometry x:Key="IconLink">M9.5,14.5 L14.5,9.5 M11,7.5 L12.8,5.7 a3.9,3.9 0 0 1 5.5,5.5 L16.5,13 M13,16.5 L11.2,18.3 a3.9,3.9 0 0 1 -5.5,-5.5 L7.5,11</Geometry>
        <Geometry x:Key="IconGear">M15.60,12.00 a3.60,3.60 0 1 1 -7.20,0 a3.60,3.60 0 1 1 7.20,0 M12.00,8.40 L12.00,6.20 M14.55,9.45 L16.10,7.90 M15.60,12.00 L17.80,12.00 M14.55,14.55 L16.10,16.10 M12.00,15.60 L12.00,17.80 M9.45,14.55 L7.90,16.10 M8.40,12.00 L6.20,12.00 M9.45,9.45 L7.90,7.90</Geometry>
        <Geometry x:Key="IconInfo">M20.5,12 a8.5,8.5 0 1 1 -17,0 a8.5,8.5 0 1 1 17,0 M12,11 L12,16.5 M12,7.6 L12,7.7</Geometry>
        <Geometry x:Key="IconLock">M6.5,11 L17.5,11 a1.5,1.5 0 0 1 1.5,1.5 L19,18.5 a1.5,1.5 0 0 1 -1.5,1.5 L6.5,20 a1.5,1.5 0 0 1 -1.5,-1.5 L5,12.5 a1.5,1.5 0 0 1 1.5,-1.5 M8.2,11 L8.2,8 a3.8,3.8 0 0 1 7.6,0 L15.8,11</Geometry>
        <Geometry x:Key="IconServer">M4.5,4.5 L19.5,4.5 a1.5,1.5 0 0 1 1.5,1.5 L21,9 a1.5,1.5 0 0 1 -1.5,1.5 L4.5,10.5 a1.5,1.5 0 0 1 -1.5,-1.5 L3,6 a1.5,1.5 0 0 1 1.5,-1.5 M4.5,13.5 L19.5,13.5 a1.5,1.5 0 0 1 1.5,1.5 L21,18 a1.5,1.5 0 0 1 -1.5,1.5 L4.5,19.5 a1.5,1.5 0 0 1 -1.5,-1.5 L3,15 a1.5,1.5 0 0 1 1.5,-1.5 M6.6,7.5 L6.7,7.5 M6.6,16.5 L6.7,16.5</Geometry>
        <Geometry x:Key="IconMonitor">M4,4.5 L20,4.5 a1.5,1.5 0 0 1 1.5,1.5 L21.5,15 a1.5,1.5 0 0 1 -1.5,1.5 L4,16.5 a1.5,1.5 0 0 1 -1.5,-1.5 L2.5,6 a1.5,1.5 0 0 1 1.5,-1.5 M9,20 L15,20 M12,16.5 L12,20</Geometry>
        <Geometry x:Key="IconLayers">M12,3.5 L21,8 L12,12.5 L3,8 Z M3,12 L12,16.5 L21,12 M3,16 L12,20.5 L21,16</Geometry>
        <Geometry x:Key="IconPulse">M2.5,12 L7,12 L9.5,5.5 L14,18.5 L16.5,12 L21.5,12</Geometry>
        <Geometry x:Key="IconRefresh">M20,12 a8,8 0 1 1 -2.6,-5.9 M20,4.5 L20,9.5 L15,9.5</Geometry>
        <Geometry x:Key="IconPlug">M8.5,3.5 L8.5,8 M15.5,3.5 L15.5,8 M6,8 L18,8 L18,12 a6,6 0 0 1 -12,0 Z M12,18 L12,21</Geometry>
        <Geometry x:Key="IconEye">M2.5,12 C5,7.5 8.5,5.6 12,5.6 C15.5,5.6 19,7.5 21.5,12 C19,16.5 15.5,18.4 12,18.4 C8.5,18.4 5,16.5 2.5,12 Z M15,12 a3,3 0 1 1 -6,0 a3,3 0 1 1 6,0</Geometry>
        <Geometry x:Key="IconCopy">M8.5,8.5 L18,8.5 a1.5,1.5 0 0 1 1.5,1.5 L19.5,19 a1.5,1.5 0 0 1 -1.5,1.5 L8.5,20.5 a1.5,1.5 0 0 1 -1.5,-1.5 L7,10 a1.5,1.5 0 0 1 1.5,-1.5 M4.5,16 L4.5,5 a1.5,1.5 0 0 1 1.5,-1.5 L16,3.5</Geometry>
        <Geometry x:Key="IconCheck">M6.5,12.4 L10.3,16 L17.5,8.6</Geometry>
        <Geometry x:Key="IconInbox">M3,13.5 L8,13.5 L9.5,16 L14.5,16 L16,13.5 L21,13.5 M3,13.5 L5.5,5.5 a1.5,1.5 0 0 1 1.4,-1 L17.1,4.5 a1.5,1.5 0 0 1 1.4,1 L21,13.5 L21,18 a1.5,1.5 0 0 1 -1.5,1.5 L4.5,19.5 a1.5,1.5 0 0 1 -1.5,-1.5 Z</Geometry>
        <Geometry x:Key="IconChevron">M9.5,6.5 L15,12 L9.5,17.5</Geometry>
        <Geometry x:Key="IconClock">M20.8,12 a8.8,8.8 0 1 1 -17.6,0 a8.8,8.8 0 1 1 17.6,0 M12,12 L12,6.8 M12,12 L15.6,14.1</Geometry>

        <!-- A warm wash over the acrylic, so the glass keeps the brand temperature even when the
             desktop behind it is cold or dark. Low alpha: it tints, it does not paint. -->
        <LinearGradientBrush x:Key="WarmWashBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#26FB9824" Offset="0" />
            <GradientStop Color="#0DFFFFF0" Offset="0.45" />
            <GradientStop Color="#1F8C381F" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PeachBrush" Color="#FFF3E6" />
        <SolidColorBrush x:Key="PeachStrongBrush" Color="#FDE3CC" />
        <SolidColorBrush x:Key="GlassEdgeBrush" Color="#B3FFFFFF" />

        <!-- Type scale from the brief. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
        </Style>

        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
          Full ControlTemplates rather than Setters: the stock .NET 8 Fluent theme hard-codes its
          own focus-state border colour, which would override anything set here and put Windows'
          system accent - usually blue - into a window that is meant to have none.
        -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource RustBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource RustBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary: rust fill, ivory label at 7.71:1. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CanvasBrush}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource RustBrush}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RustHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OnAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent: orange fill, deepened rust label at 4.73:1. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OnAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                BorderBrush="{StaticResource RustBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RustBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square button for the show/copy affordances beside the key field. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource RustBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource GlassFieldBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RustBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation. RadioButtons so exactly one is current, with arrow-key movement
             and screen-reader semantics coming for free. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#3D1E12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Glyph" Grid.Column="0" Width="22" Height="22" Stretch="Uniform"
                                      Data="{TemplateBinding Tag}" Stroke="{StaticResource RustBrush}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Margin="0,0,12,0" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                <Path x:Name="Chevron" Grid.Column="2" Width="13" Height="13" Stretch="Uniform"
                                      Data="{StaticResource IconChevron}" Stroke="{StaticResource OnAccentBrush}"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFF3E6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PeachStrongBrush}" />
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource OnAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RustBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The field's frame carries the leading icon, so focus lights the whole box. -->
        <Style x:Key="FieldShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassFieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource RustBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D9C6B4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricIconTile" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{StaticResource PeachBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="CardIconTile" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource PeachStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WarmWashBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="18,0,0,0" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource RustBrush}" Margin="0,0,10,0">
                <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconClock}"
                      Stroke="#FFFFF0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <TextBlock Text="TimeTracker Agent - Settings" FontSize="13" FontWeight="SemiBold"
                       Foreground="#3D1E12" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ============================ Sidebar ============================ -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource GlassSidebarBrush}"
                BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="24,10,24,20">
                <Border Width="62" Height="62" CornerRadius="18" Background="{StaticResource PeachStrongBrush}"
                        HorizontalAlignment="Left">
                    <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource RustBrush}">
                    <!-- The product's own clock mark, same as the console favicon. -->
                        <Path Width="26" Height="26" Stretch="Uniform" Data="{StaticResource IconClock}"
                              Stroke="#FFFFF0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                </Border>

                <TextBlock Text="TIMETRACKER AGENT" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,20,0,0" />
                <TextBlock Text="Settings" FontSize="27" FontWeight="Bold"
                           Foreground="#3D1E12" Margin="0,2,0,24" />

                <RadioButton x:Name="NavConnection" Tag="{StaticResource IconLink}" Style="{StaticResource NavItem}" GroupName="Nav"
                             IsChecked="True" Checked="OnNavChanged" Content="Connection" />
                <RadioButton x:Name="NavGeneral" Tag="{StaticResource IconGear}" Style="{StaticResource NavItem}" GroupName="Nav"
                             Checked="OnNavChanged" Content="General" />
                <RadioButton x:Name="NavAbout" Tag="{StaticResource IconInfo}" Style="{StaticResource NavItem}" GroupName="Nav"
                             Checked="OnNavChanged" Content="About" />
            </StackPanel>
        </Border>

        <!-- ============================ Content ============================ -->
        <Grid Grid.Row="1" Grid.Column="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,22,32,14">
                <TextBlock x:Name="SectionTitle" Text="Connection settings" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SectionSubtitle" Style="{StaticResource PageSubtitle}"
                           Text="Keep this device securely connected to your TimeTracker workspace." />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,8">

                <!-- ====================== Connection ====================== -->
                <StackPanel>
                    <StackPanel x:Name="ConnectionPanel">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource CardIconTile}">
                                        <Path Width="24" Height="24" Stretch="Uniform" Data="{StaticResource IconServer}"
                                              Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Server connection" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Enter the server address and the key supplied by your administrator." />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                                <Border Style="{StaticResource FieldShell}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconLink}"
                                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" x:Name="ServerUrlBox" Style="{StaticResource FieldBox}" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="Agent API key" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FieldShell}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconLock}"
                                                  Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Grid Grid.Column="1">
                                                <PasswordBox x:Name="ApiKeyPasswordBox" Style="{StaticResource FieldPasswordBox}" />
                                                <TextBox x:Name="ApiKeyTextBox" Style="{StaticResource FieldBox}" Visibility="Collapsed" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" x:Name="ShowKeyButton" Style="{StaticResource IconButton}"
                                            Margin="8,0,0,0" Click="OnToggleKeyVisibility"
                                            ToolTip="Show or hide the key"
                                            AutomationProperties.Name="Show or hide the API key">
                                        <Path Width="21" Height="21" Stretch="Uniform" Data="{StaticResource IconEye}"
                                              Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="CopyKeyButton" Style="{StaticResource IconButton}"
                                            Margin="8,0,0,0" Click="OnCopyKey"
                                            ToolTip="Copy the key to the clipboard"
                                            AutomationProperties.Name="Copy the API key">
                                        <Path Width="21" Height="21" Stretch="Uniform" Data="{StaticResource IconCopy}"
                                              Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Button>
                                </Grid>

                                <CheckBox x:Name="ShowKeyCheckBox" Content="Show API key" Margin="0,12,0,0"
                                          Checked="OnShowKeyChanged" Unchecked="OnShowKeyChanged" />

                                <!-- Connection status. Rust on a warm surface: no green, no blue. -->
                                <Border x:Name="ConnStatusPanel" Background="{StaticResource PeachBrush}"
                                        BorderBrush="{StaticResource PeachStrongBrush}" BorderThickness="1"
                                        CornerRadius="14" Padding="18,16" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border x:Name="ConnStatusDot" Width="34" Height="34" CornerRadius="17"
                                                    Background="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                    Margin="0,0,14,0">
                                                <Path x:Name="ConnStatusGlyph" Width="19" Height="19" Stretch="Uniform"
                                                      Data="{StaticResource IconCheck}" Stroke="#FFFFF0" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="ConnStatusTitle" Text="Connection not tested yet"
                                                           FontSize="15.5" FontWeight="SemiBold" Foreground="#3D1E12" />
                                                <TextBlock x:Name="StatusText" FontSize="13.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                                           Text="Use Test Connection to check the address and key against the server." />
                                            </StackPanel>
                                        </StackPanel>

                                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource PeachStrongBrush}" Margin="18,2" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="Last checked" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="LastCheckedText" Text="not yet" FontSize="13.5"
                                                       FontWeight="SemiBold" Foreground="#3D1E12" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="3" x:Name="TestAgainButton" Style="{StaticResource OutlineButton}"
                                                Height="40" Padding="16,0" FontSize="13.5" VerticalAlignment="Center"
                                                Click="OnTestConnection">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconRefresh}"
                                                      Stroke="{StaticResource RustBrush}" StrokeThickness="1.9"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" Margin="0,0,9,0" />
                                                <TextBlock Text="Test Again" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ====================== Agent status ====================== -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Style="{StaticResource CardIconTile}">
                                            <Path Width="24" Height="24" Stretch="Uniform" Data="{StaticResource IconMonitor}"
                                                  Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Agent status" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource CardDescription}"
                                                       Text="Current status and information about the agent on this machine." />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="RunningBadge" Grid.Column="1" Background="{StaticResource PeachStrongBrush}"
                                            CornerRadius="18" Padding="16,8" Height="36" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBlock x:Name="RunningBadgeText" Text="Checking" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OnAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource GlassFieldBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,18,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Style="{StaticResource MetricIconTile}">
                                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconLayers}"
                                                      Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Version" Style="{StaticResource MetricLabel}" />
                                                <TextBlock x:Name="VersionText" Style="{StaticResource MetricValue}" Text="-" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource HairlineBrush}" Margin="16,2" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Border Style="{StaticResource MetricIconTile}">
                                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconPulse}"
                                                      Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Last heartbeat" Style="{StaticResource MetricLabel}" />
                                                <TextBlock x:Name="HeartbeatText" Style="{StaticResource MetricValue}" Text="-" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource HairlineBrush}" Margin="16,2" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Border Style="{StaticResource MetricIconTile}">
                                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconInbox}"
                                                      Stroke="{StaticResource RustBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Queued events" Style="{StaticResource MetricLabel}" />
                                                <TextBlock x:Name="QueuedText" Style="{StaticResource MetricValue}" Text="-" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Restart notice: orange-tinted surface, rust text. No blue. -->
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10"
                                        Padding="16,13" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Top" Margin="0,1,12,0">
                                            <TextBlock Text="i" FontWeight="Bold" FontSize="12.5"
                                                       Foreground="{StaticResource OnAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                                                   Foreground="{StaticResource RustBrush}"
                                                   Text="Changes apply after the Agent restarts. Restart now, or let the background watchdog apply them within a few minutes." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====================== General ====================== -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Local configuration" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           Text="How this Agent is set up on this machine. Capture rules - which event types are recorded - are set per device in the server console, not here." />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Data folder" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DataDirText" Style="{StaticResource MetricValue}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sync interval" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SyncIntervalText" Style="{StaticResource MetricValue}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Screenshot interval" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ScreenshotIntervalText" Style="{StaticResource MetricValue}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Idle after" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="IdleThresholdText" Style="{StaticResource MetricValue}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Device ID" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DeviceIdText" Style="{StaticResource MetricValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====================== About ====================== -->
                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TimeTracker Agent" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           Text="Records application use, idle time, locks and screenshots on this machine, and sends them to your TimeTracker server." />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersionText" Style="{StaticResource MetricValue}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Installed at" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InstallPathText" Style="{StaticResource MetricValue}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Event log source" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EventSourceText" Style="{StaticResource MetricValue}" />
                                </Grid>

                                <Border Background="{StaticResource GlassStatusBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,18,0,0">
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                               Text="This machine is monitored for workplace reporting. What is recorded is controlled by your administrator in the server console, per device." />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Footer ============================ -->
            <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                    Background="#99FFFDF6" Padding="34,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel" />

                    <!-- Wraps rather than overflowing when the window is narrowed. -->
                    <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TestButton" Style="{StaticResource OutlineButton}"
                                Margin="10,4,0,0" Click="OnTestConnection">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconPlug}"
                                      Stroke="{StaticResource RustBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Save Changes" Style="{StaticResource AccentButton}"
                                Margin="10,4,0,0" Click="OnSave" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="10,4,0,0" Click="OnSaveAndRestart">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconRefresh}"
                                      Stroke="#FFFFF0" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Save &amp; Restart Now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
