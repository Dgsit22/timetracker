@page
@model TimeTracker.Server.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<h1 class="page-heading">Change password</h1>
<p class="page-subtitle">Changes take effect immediately and sign you out everywhere else.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success py-2">@Model.StatusMessage</div>
}

<div class="card" style="max-width: 32rem">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Input.CurrentPassword"></label>
            <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            <div class="form-text">At least 6 characters, with an upper and lower case letter, a digit, and a symbol.</div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary">Change password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
