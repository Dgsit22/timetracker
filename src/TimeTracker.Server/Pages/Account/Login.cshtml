@page
@model TimeTracker.Server.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<div class="login-page">

    @*
        Decorative only - the scene carries no information the form does not, so it is hidden
        from assistive technology rather than described. Layer order is back to front, and each
        layer's data-depth is how far it travels against pointer movement (see login-scene.js).
    *@
    <div class="scene" aria-hidden="true">

        @* ---- The clock, rising ------------------------------------------------ *@
        <div class="scene-layer scene-sun" data-depth="0.02">
            <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
                <defs>
                    <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#FEAE96" stop-opacity="0.85" />
                        <stop offset="45%" stop-color="#FEAE96" stop-opacity="0.32" />
                        <stop offset="100%" stop-color="#FEAE96" stop-opacity="0" />
                    </radialGradient>
                </defs>

                <circle class="sun-glow" cx="1150" cy="300" r="330" fill="url(#sunGlow)" />
                <circle cx="1150" cy="300" r="152" fill="#FFF9F4" opacity="0.94" />
                <circle cx="1150" cy="300" r="152" fill="none" stroke="#FE979C" stroke-width="3" opacity="0.7" />

                @* Hour ticks: long at the quarters, short between. *@
                <g stroke="#013237" stroke-linecap="round" opacity="0.5">
                    <g stroke-width="5">
                        <line x1="1150" y1="166" x2="1150" y2="186" />
                        <line x1="1284" y1="300" x2="1264" y2="300" />
                        <line x1="1150" y1="434" x2="1150" y2="414" />
                        <line x1="1016" y1="300" x2="1036" y2="300" />
                    </g>
                    <g stroke-width="3" opacity="0.7">
                        <line x1="1217" y1="184" x2="1211" y2="196" />
                        <line x1="1266" y1="233" x2="1254" y2="239" />
                        <line x1="1266" y1="367" x2="1254" y2="361" />
                        <line x1="1217" y1="416" x2="1211" y2="404" />
                        <line x1="1083" y1="416" x2="1089" y2="404" />
                        <line x1="1034" y1="367" x2="1046" y2="361" />
                        <line x1="1034" y1="233" x2="1046" y2="239" />
                        <line x1="1083" y1="184" x2="1089" y2="196" />
                    </g>
                </g>

                @* Hands are rotated to the viewer's local time by login-scene.js. *@
                <rect id="handHour" class="clock-hand clock-hand--hour" x="1145" y="222" width="10" height="78" rx="5" fill="#013237" opacity="0.88" />
                <rect id="handMinute" class="clock-hand clock-hand--minute" x="1146.5" y="190" width="7" height="110" rx="3.5" fill="#013237" opacity="0.88" />
                <rect id="handSecond" class="clock-hand clock-hand--second" x="1148.5" y="176" width="3" height="124" rx="1.5" fill="#FE979C" />
                <circle cx="1150" cy="300" r="9" fill="#013237" />
                <circle cx="1150" cy="300" r="3.5" fill="#FFF9F4" />
            </svg>
        </div>

        @* ---- Far ridge: the skyline they are running toward ------------------- *@
        <div class="scene-layer scene-far" data-depth="0.05">
            <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
                <g fill="#013237" opacity="0.13">
                    <path d="M0 612 L120 586 L268 606 L392 570 L520 598 L664 560 L806 592 L944 566 L1096 600 L1240 572 L1388 598 L1512 578 L1600 596 L1600 900 L0 900 Z" />
                </g>

                @* Distant clock towers - the same face as the sun, read at a glance. *@
                <g opacity="0.2">
                    <g fill="#013237">
                        <rect x="386" y="470" width="34" height="104" rx="3" />
                        <path d="M382 470 L403 446 L424 470 Z" />
                        <circle cx="403" cy="502" r="11" fill="#FDF6F2" />
                        <circle cx="403" cy="502" r="11" fill="none" stroke="#013237" stroke-width="2" />
                        <path d="M403 502 L403 495 M403 502 L408 504" stroke="#013237" stroke-width="2" stroke-linecap="round" fill="none" />
                    </g>
                    <g fill="#013237">
                        <rect x="1006" y="494" width="26" height="80" rx="3" />
                        <path d="M1003 494 L1019 474 L1035 494 Z" />
                        <circle cx="1019" cy="518" r="8" fill="#FDF6F2" />
                        <circle cx="1019" cy="518" r="8" fill="none" stroke="#013237" stroke-width="2" />
                        <path d="M1019 518 L1019 513 M1019 518 L1023 520" stroke="#013237" stroke-width="2" stroke-linecap="round" fill="none" />
                    </g>
                </g>
            </svg>
        </div>

        @* ---- Mid ridge: the crowd ------------------------------------------- *@
        <div class="scene-layer scene-mid" data-depth="0.12">
            <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
                <defs>
                    @*
                        Runners are drawn once and placed with <use>. Feet sit at local y=0 so a
                        translate puts them exactly on the ridge line, and stroke weight scales
                        with the figure, which is what sells the distance.
                    *@
                    <g id="runnerCase" fill="none" stroke="#013237" stroke-width="7"
                       stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="8" cy="-72" r="8" fill="#013237" stroke="none" />
                        <path d="M4 -62 L-2 -34" />
                        <path d="M-2 -34 L12 -20 L18 -3" />
                        <path d="M-2 -34 L-16 -22 L-25 -7" />
                        <path d="M4 -60 L16 -52 L13 -41" />
                        <path d="M4 -60 L-9 -54 L-18 -45" />
                        <rect x="5" y="-40" width="19" height="14" rx="2.5" stroke-width="5" />
                    </g>

                    <g id="runnerFree" fill="none" stroke="#013237" stroke-width="7"
                       stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="-73" r="8" fill="#013237" stroke="none" />
                        <path d="M5 -63 L-3 -35" />
                        <path d="M-3 -35 L14 -24 L22 -4" />
                        <path d="M-3 -35 L-18 -25 L-14 -6" />
                        <path d="M5 -61 L19 -55 L24 -44" />
                        <path d="M5 -61 L-11 -57 L-19 -64" />
                    </g>

                    <g id="runnerLate" fill="none" stroke="#013237" stroke-width="7"
                       stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="10" cy="-70" r="8" fill="#013237" stroke="none" />
                        <path d="M6 -60 L-4 -33" />
                        <path d="M-4 -33 L10 -18 L20 -2" />
                        <path d="M-4 -33 L-19 -24 L-27 -9" />
                        <path d="M6 -58 L20 -50 L26 -56" />
                        <path d="M6 -58 L-10 -52 L-16 -40" />
                        <rect x="14" y="-56" width="16" height="12" rx="2.5" stroke-width="5" />
                    </g>
                </defs>

                <g fill="#013237" opacity="0.24">
                    <path d="M0 690 L146 664 L306 686 L452 652 L606 682 L764 650 L918 680 L1074 654 L1232 684 L1386 658 L1522 682 L1600 668 L1600 900 L0 900 Z" />
                </g>

                @* Long shadows run back from the light, so they fall left of each figure. *@
                <g opacity="0.75">
                    <g transform="translate(232 672) scale(0.62)" class="runner--trailing">
                        <ellipse cx="-10" cy="3" rx="30" ry="5" fill="#013237" opacity="0.16" />
                        <use href="#runnerFree" opacity="0.5" />
                    </g>
                    <g transform="translate(430 678) scale(0.78)">
                        <ellipse cx="-12" cy="3" rx="32" ry="5" fill="#013237" opacity="0.18" />
                        <use href="#runnerCase" opacity="0.62" />
                    </g>
                    <g transform="translate(690 684) scale(0.7)" class="runner--trailing">
                        <ellipse cx="-10" cy="3" rx="30" ry="5" fill="#013237" opacity="0.16" />
                        <use href="#runnerLate" opacity="0.55" />
                    </g>
                    <g transform="translate(1188 676) scale(0.84)">
                        <ellipse cx="-14" cy="3" rx="34" ry="6" fill="#013237" opacity="0.2" />
                        <use href="#runnerFree" opacity="0.66" />
                    </g>
                    <g transform="translate(1412 686) scale(0.72)" class="runner--trailing">
                        <ellipse cx="-12" cy="3" rx="30" ry="5" fill="#013237" opacity="0.16" />
                        <use href="#runnerCase" opacity="0.58" />
                    </g>
                </g>
            </svg>
        </div>

        @* ---- Near ridge: the ground you are standing on ---------------------- *@
        <div class="scene-layer scene-near" data-depth="0.2">
            <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
                <g fill="#013237">
                    <path d="M0 792 L128 766 L286 790 L430 758 L588 788 L742 760 L898 790 L1052 762 L1210 792 L1364 764 L1508 790 L1600 774 L1600 900 L0 900 Z" opacity="0.9" />
                </g>

                @* Two figures close enough to read as solid, one already well ahead. *@
                <g transform="translate(300 800) scale(1.18)">
                    <ellipse cx="-16" cy="4" rx="40" ry="7" fill="#013237" opacity="0.22" />
                    <use href="#runnerCase" />
                </g>
                @* Centre-band figure: the one that survives the crop on a phone. *@
                <g transform="translate(880 812) scale(1.1)">
                    <ellipse cx="-15" cy="4" rx="38" ry="6" fill="#013237" opacity="0.21" />
                    <use href="#runnerFree" />
                </g>
                <g transform="translate(1320 806) scale(1.06)">
                    <ellipse cx="-14" cy="4" rx="36" ry="6" fill="#013237" opacity="0.2" />
                    <use href="#runnerLate" />
                </g>

                <g stroke="#013237" stroke-width="5" stroke-linecap="round" opacity="0.92">
                    <path d="M92 800 L88 778 M110 802 L114 782 M126 800 L122 784" />
                    <path d="M620 798 L616 776 M638 800 L642 780" />
                    <path d="M980 800 L976 780 M998 802 L1002 782 M1014 800 L1010 786" />
                    <path d="M1520 800 L1516 780 M1538 802 L1542 784" />
                </g>
            </svg>
        </div>

        @* ---- Foreground: minutes drifting past ------------------------------- *@
        <div class="scene-layer scene-motes" data-depth="0.34">
            <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
                <g fill="none" stroke="#013237" stroke-linecap="round">
                    <g opacity="0.16" stroke-width="3">
                        <circle cx="196" cy="232" r="21" />
                        <path d="M196 232 L196 220 M196 232 L205 236" />
                    </g>
                    <g opacity="0.12" stroke-width="2.5">
                        <circle cx="486" cy="150" r="15" />
                        <path d="M486 150 L486 141 M486 150 L493 153" />
                    </g>
                    <g opacity="0.14" stroke-width="2.5">
                        <circle cx="1466" cy="212" r="17" />
                        <path d="M1466 212 L1466 202 M1466 212 L1474 215" />
                    </g>
                    <g opacity="0.1" stroke-width="2">
                        <circle cx="820" cy="118" r="12" />
                        <path d="M820 118 L820 111 M820 118 L826 120" />
                    </g>
                </g>
            </svg>
        </div>
    </div>

    <div class="login-shell">
        <div class="login-card">

            <div class="login-mark">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7.5V12l3 1.8" />
                </svg>
                <span>TimeTracker</span>
            </div>

            <h1 class="login-title">Log in</h1>
            <p class="login-lede">Track &middot; Analyze &middot; Work Smarter</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="login-alert" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7.5v5" />
                        <path d="M12 16.2h.01" />
                    </svg>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Input.Email">Email</label>
                    <div class="field-input">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2.5" />
                            <path d="m3.5 7 8.5 6 8.5-6" />
                        </svg>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username"
                               placeholder="you@@company.com" autofocus />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Input.Password">Password</label>
                    <div class="field-input">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="4.5" y="10.5" width="15" height="9.5" rx="2.5" />
                            <path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7" />
                        </svg>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                               placeholder="Your password" data-password-input />
                        <button type="button" class="field-toggle" data-password-toggle
                                aria-label="Show password" aria-pressed="false">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                                 data-icon="shown">
                                <path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z" />
                                <circle cx="12" cy="12" r="3.2" />
                            </svg>
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                                 data-icon="hidden" hidden>
                                <path d="M4 4.5l16 15" />
                                <path d="M9.6 6.2A9.6 9.6 0 0 1 12 5.8c6 0 9.5 6.2 9.5 6.2a17 17 0 0 1-3.3 4" />
                                <path d="M6.4 8.1A16.8 16.8 0 0 0 2.5 12S6 18.2 12 18.2a9.4 9.4 0 0 0 3.5-.66" />
                                <path d="M9.9 9.9a3.2 3.2 0 0 0 4.3 4.3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <button type="submit" class="login-submit" data-submit>
                    <span class="login-submit-label">Log in</span>
                </button>
            </form>
        </div>
    </div>

    <footer class="login-foot">
        <span>&copy; 2026 TimeTracker.Server</span>
        <span class="login-foot-dot" aria-hidden="true"></span>
        <a asp-page="/Privacy">Privacy</a>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login-scene.js" asp-append-version="true"></script>
}
