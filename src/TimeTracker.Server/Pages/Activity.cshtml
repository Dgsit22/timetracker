@page
@using System.Text.Json
@model ActivityModel
@{
    ViewData["Title"] = "Activity";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="page-heading">Activity</h1>
        <p class="page-subtitle mb-0">Monitor application usage, website visits and device activity across your organization.</p>
    </div>
</div>

<div class="filter-bar mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-auto">
            <label class="col-form-label" for="UserName">User</label>
        </div>
        <div class="col-auto">
            <select class="form-select" id="UserName" name="UserName" onchange="this.form.submit()">
                <option value="">All users</option>
                @foreach (var user in Model.KnownUsers)
                {
                    <option value="@user" selected="@(user == Model.UserName)">@user</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="col-form-label" for="DeviceId">Device</label>
        </div>
        <div class="col-auto">
            <select class="form-select" id="DeviceId" name="DeviceId" onchange="this.form.submit()">
                <option value="">All devices</option>
                @foreach (var device in Model.KnownDevices)
                {
                    <option value="@device.DeviceId" selected="@(device.DeviceId == Model.DeviceId)">@device.MachineName</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="col-form-label" for="FromDate">From</label>
        </div>
        <div class="col-auto">
            <input type="date" class="form-control" id="FromDate" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </div>
        <div class="col-auto">
            <label class="col-form-label" for="ToDate">To</label>
        </div>
        <div class="col-auto">
            <input type="date" class="form-control" id="ToDate" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </div>
        <div class="col-auto btn-group" role="group" aria-label="Quick date range">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDateRange(0)">Today</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDateRange(6)">Last 7 days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDateRange(29)">Last 30 days</button>
        </div>
        <div class="col-12 d-flex flex-wrap gap-2 mt-2">
            @foreach (var type in ActivityModel.EventTypes)
            {
                var isChecked = !Model.TypesFilterApplied || (Model.Types?.Contains(type) ?? false);
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="Types_@type" name="Types" value="@type" checked="@isChecked" onchange="this.form.submit()" />
                    <label class="form-check-label" for="Types_@type">@type</label>
                </div>
            }
            <input type="hidden" name="TypesFilterApplied" value="true" />
        </div>
    </form>
</div>

@if (Model.DeviceSummaries.Count > 0)
{
    <div class="mb-4">
        @foreach (var summary in Model.DeviceSummaries)
        {
            <div class="card mb-3">
                <div class="card-header"><strong>@summary.MachineName</strong></div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-auto">
                            <div class="text-muted small">Active time</div>
                            <div class="fs-4">@ActivityAggregation.FormatDuration(summary.ActiveSeconds)</div>
                        </div>
                        <div class="col-auto">
                            <div class="text-muted small">Idle time</div>
                            <div class="fs-4">@ActivityAggregation.FormatDuration(summary.IdleSeconds)</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Top 5 Apps</h6>
                            <div style="height:220px">
                                <canvas id="chart-apps-@summary.DeviceId"></canvas>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>Top 5 Websites</h6>
                            <div style="height:220px">
                                <canvas id="chart-sites-@summary.DeviceId"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card">
    <div class="card-header"><strong>Activity Log (@Model.Rows.Count)</strong></div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Time (<span class="tz-label">UTC</span>)</th>
                    <th>User</th>
                    <th>Device</th>
                    <th>Type</th>
                    <th>Details</th>
                    <th>Duration</th>
                    <th>Screenshot</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td data-utc="@row.TimestampUtc.ToString("o")" data-utc-format="datetime-s">@row.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@row.UserName</td>
                        <td title="@row.DeviceId">@row.DeviceId.ToString()[..8]</td>
                        <td><span class="badge-soft">@row.Kind</span></td>
                        <td>@row.Details</td>
                        <td>@(row.DurationSeconds is { } d ? ActivityAggregation.FormatRowDuration(d) : "")</td>
                        <td>
                            @if (row.ScreenshotId is { } screenshotId)
                            {
                                <a href="/api/screenshots/@screenshotId" target="_blank">
                                    <img src="/api/screenshots/@screenshotId" style="max-width:100px;max-height:60px" />
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">&#9679;&#9679;</div>
            <div>No activity received yet. Make sure the Agent's sync client is running and pointed at this server.</div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        function setDateRange(daysBack) {
            const to = new Date();
            const from = new Date();
            from.setDate(to.getDate() - daysBack);
            document.getElementById('FromDate').value = from.toISOString().slice(0, 10);
            document.getElementById('ToDate').value = to.toISOString().slice(0, 10);
            document.getElementById('FromDate').form.submit();
        }

        const deviceChartData = @Html.Raw(JsonSerializer.Serialize(
            Model.DeviceSummaries.Select(s => new { deviceId = s.DeviceId, topApps = s.TopApps, topSites = s.TopSites }),
            ActivityAggregation.ChartJsonOptions));

        function renderDonut(canvasId, slices) {
            const el = document.getElementById(canvasId);
            if (!el) return;
            if (!slices || slices.length === 0) {
                el.replaceWith(Object.assign(document.createElement('p'), { className: 'text-muted', textContent: 'No data' }));
                return;
            }
            new Chart(el, {
                type: 'doughnut',
                data: {
                    labels: slices.map(s => s.label),
                    datasets: [{ data: slices.map(s => s.seconds) }]
                },
                options: { maintainAspectRatio: false }
            });
        }

        deviceChartData.forEach(d => {
            renderDonut('chart-apps-' + d.deviceId, d.topApps);
            renderDonut('chart-sites-' + d.deviceId, d.topSites);
        });
    </script>
}
