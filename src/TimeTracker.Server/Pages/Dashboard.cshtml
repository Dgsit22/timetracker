@page
@using System.Text.Json
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";

    string ChangeBadge(double? percent)
    {
        if (percent is null)
        {
            return "<span class=\"text-muted small\">no prior data</span>";
        }

        var rounded = Math.Round(percent.Value);
        var arrow = rounded >= 0 ? "&#8593;" : "&#8595;";
        var cls = rounded >= 0 ? "text-success" : "text-danger";
        return $"<span class=\"{cls} small fw-semibold\">{arrow} {Math.Abs(rounded)}%</span> <span class=\"text-muted small\">vs previous period</span>";
    }
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="page-heading">Dashboard</h1>
        <p class="page-subtitle mb-0">Organization-wide activity at a glance.</p>
    </div>
</div>

<div class="filter-bar mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-auto">
            <label class="col-form-label" for="UserName">User</label>
        </div>
        <div class="col-auto">
            <select class="form-select" id="UserName" name="UserName" onchange="this.form.submit()">
                <option value="">All users</option>
                @foreach (var user in Model.KnownUsers)
                {
                    <option value="@user" selected="@(user == Model.UserName)">@user</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="col-form-label" for="DeviceId">Device</label>
        </div>
        <div class="col-auto">
            <select class="form-select" id="DeviceId" name="DeviceId" onchange="this.form.submit()">
                <option value="">All devices</option>
                @foreach (var device in Model.KnownDevices)
                {
                    <option value="@device.DeviceId" selected="@(device.DeviceId == Model.DeviceId)">@device.MachineName</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="col-form-label" for="FromDate">From</label>
        </div>
        <div class="col-auto">
            <input type="date" class="form-control" id="FromDate" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </div>
        <div class="col-auto">
            <label class="col-form-label" for="ToDate">To</label>
        </div>
        <div class="col-auto">
            <input type="date" class="form-control" id="ToDate" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </div>
        <div class="col-auto btn-group" role="group" aria-label="Quick date range">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDateRange(0)">Today</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDateRange(6)">Last 7 days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDateRange(29)">Last 30 days</button>
        </div>
    </form>
</div>

<div class="kpi-row mb-4">
    <div class="kpi-card">
        <div class="kpi-icon">&#9200;</div>
        <div>
            <div class="kpi-label">Total Active Time</div>
            <div class="kpi-value">@ActivityAggregation.FormatDuration(Model.TotalActiveSeconds)</div>
            @Html.Raw(ChangeBadge(Model.ActiveChangePercent))
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon">&#9749;</div>
        <div>
            <div class="kpi-label">Total Idle Time</div>
            <div class="kpi-value">@ActivityAggregation.FormatDuration(Model.TotalIdleSeconds)</div>
            @Html.Raw(ChangeBadge(Model.IdleChangePercent))
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon">&#128200;</div>
        <div>
            <div class="kpi-label">Total Events</div>
            <div class="kpi-value">@Model.TotalEvents</div>
            @Html.Raw(ChangeBadge(Model.EventsChangePercent))
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon">&#128421;</div>
        <div>
            <div class="kpi-label">Active Devices</div>
            <div class="kpi-value">@Model.ActiveDeviceCount</div>
            <span class="text-muted small">out of @Model.TotalDeviceCount devices</span>
        </div>
    </div>
</div>

@{
    string StateBadge(string state) => state switch
    {
        "Reporting" => "<span class=\"badge-soft\" style=\"background:#DFF3EA;color:#1F7A5C\">Reporting</span>",
        "Late" => "<span class=\"badge-soft\" style=\"background:#FCE8DF;color:#8A4B2A\">Late</span>",
        _ => "<span class=\"badge-soft\" style=\"background:#F8DAD6;color:#C0392B\">Silent</span>",
    };

    string Ago(TimeSpan t) =>
        t.TotalSeconds < 60 ? $"{(int)t.TotalSeconds}s ago"
        : t.TotalMinutes < 60 ? $"{(int)t.TotalMinutes}m ago"
        : t.TotalHours < 24 ? $"{(int)t.TotalHours}h {t.Minutes}m ago"
        : $"{(int)t.TotalDays}d ago";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Agent status</strong>
        <span class="text-muted small">Live &mdash; not affected by the date filter above. Counts cover the last hour.</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Machine</th>
                    <th>Last user</th>
                    <th>Status</th>
                    <th>Last reported</th>
                    <th>Events (1h)</th>
                    <th>App</th>
                    <th>Idle</th>
                    <th>Not capturing</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in Model.AgentStatuses)
                {
                    <tr>
                        <td>
                            @if (agent.IsPinned)
                            {
                                <span class="text-danger" title="Pinned">&#128204;</span>
                            }
                            @agent.MachineName
                        </td>
                        <td>@agent.LastUserName</td>
                        <td>@Html.Raw(StateBadge(agent.State))</td>
                        <td title="@agent.LastSeenUtc.ToString("u")">@Ago(agent.SilentFor)</td>
                        <td>@agent.EventsLastHour</td>
                        <td>@agent.AppEventsLastHour</td>
                        <td>@agent.IdleEventsLastHour</td>
                        <td>
                            @if (string.IsNullOrEmpty(agent.DisabledCaptures))
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                            else
                            {
                                <span class="text-danger small">@agent.DisabledCaptures</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.AgentStatuses.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">&#128225;</div>
            <div>No agents have registered yet.</div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><strong>Top 5 Applications</strong></div>
            <div class="card-body">
                @if (Model.TopApps.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">&#9633;&#9633;</div>
                        <div>No application data for the selected period.</div>
                    </div>
                }
                else
                {
                    <div style="height:240px">
                        <canvas id="chart-top-apps"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><strong>Top 5 Websites</strong></div>
            <div class="card-body">
                @if (Model.TopSites.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">&#9633;&#9633;</div>
                        <div>No website data for the selected period.</div>
                    </div>
                }
                else
                {
                    <div style="height:240px">
                        <canvas id="chart-top-sites"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        function setDateRange(daysBack) {
            const to = new Date();
            const from = new Date();
            from.setDate(to.getDate() - daysBack);
            document.getElementById('FromDate').value = from.toISOString().slice(0, 10);
            document.getElementById('ToDate').value = to.toISOString().slice(0, 10);
            document.getElementById('FromDate').form.submit();
        }

        const topApps = @Html.Raw(JsonSerializer.Serialize(Model.TopApps, ActivityAggregation.ChartJsonOptions));
        const topSites = @Html.Raw(JsonSerializer.Serialize(Model.TopSites, ActivityAggregation.ChartJsonOptions));

        function renderDonut(canvasId, slices) {
            const el = document.getElementById(canvasId);
            if (!el || !slices || slices.length === 0) return;
            new Chart(el, {
                type: 'doughnut',
                data: { labels: slices.map(s => s.label), datasets: [{ data: slices.map(s => s.seconds) }] },
                options: { maintainAspectRatio: false }
            });
        }

        renderDonut('chart-top-apps', topApps);
        renderDonut('chart-top-sites', topSites);
    </script>
}
