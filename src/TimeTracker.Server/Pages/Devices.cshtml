@page
@model DevicesModel
@{
    ViewData["Title"] = "Devices";
}

<h1 class="page-heading">Devices</h1>
<p class="page-subtitle">Turn off event types a machine shouldn't report. Screenshots are the heaviest to store &mdash; disable them, or capture them less often, per machine. Changes reach the Agent within 5 minutes.</p>

@* Forms live outside the table: a <form> cannot be nested inside <tr>/<td> and still post
   reliably, so each row's controls reference one of these by id via the form="" attribute. *@
@foreach (var device in Model.Devices)
{
    <form id="device-@device.DeviceId" method="post">@Html.AntiForgeryToken()</form>
    <form id="pin-@device.DeviceId" method="post" asp-page-handler="TogglePin">
        @Html.AntiForgeryToken()
        <input type="hidden" name="deviceId" value="@device.DeviceId" />
    </form>
    <form id="delete-@device.DeviceId" method="post" asp-page-handler="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" name="deviceId" value="@device.DeviceId" />
    </form>
}

<div class="card">
<div class="table-responsive">
<table class="table table-sm table-hover mb-0">
    <thead>
        <tr>
            <th>Machine</th>
            <th>Last user</th>
            <th>First seen (<span class="tz-label">UTC</span>)</th>
            <th>Last seen (<span class="tz-label">UTC</span>)</th>
            <th title="The Agent checks in at least hourly, even on a quiet machine. Nothing for @DevicesModel.OfflineAfterHours hours means it has stopped reporting.">Status</th>
            <th>Idle today</th>
            <th>App usage</th>
            <th>URL visits</th>
            <th>Idle</th>
            <th>Session breaks</th>
            <th>Screenshots</th>
            <th title="How often the Agent captures a screenshot. Takes effect within 5 minutes, no reinstall needed.">Screenshot every</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var device in Model.Devices)
        {
            var formId = $"device-{device.DeviceId}";
            <tr>
                <td title="@device.DeviceId">
                    @if (device.IsPinned)
                    {
                        <span class="text-danger" title="Pinned to the top">&#128204;</span>
                    }
                    @device.MachineName
                </td>
                <td>@device.LastUserName</td>
                <td data-utc="@device.FirstSeenUtc.ToString("o")" data-utc-format="datetime">@device.FirstSeenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td data-utc="@device.LastSeenUtc.ToString("o")" data-utc-format="datetime">@device.LastSeenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (DevicesModel.IsReporting(device))
                    {
                        <span class="device-state"><span class="status-dot"></span>Reporting</span>
                    }
                    else
                    {
                        <span class="device-state device-state-silent" title="Last check-in @device.LastSeenUtc.ToString("yyyy-MM-dd HH:mm") UTC">
                            <span class="status-dot status-dot-silent"></span>@DevicesModel.FormatSilence(device)
                        </span>
                    }
                </td>
                <td>@DevicesModel.FormatIdle(Model.IdleTodayByDevice.GetValueOrDefault(device.DeviceId))</td>
                <td>
                    <input form="@formId" type="hidden" name="deviceId" value="@device.DeviceId" />
                    <div class="form-check form-switch mb-0">
                        <input form="@formId" class="form-check-input" type="checkbox" role="switch"
                               id="captureAppUsage-@device.DeviceId" name="captureAppUsage" value="true"
                               checked="@device.CaptureAppUsage" />
                    </div>
                    <input form="@formId" type="hidden" name="captureAppUsage" value="false" />
                </td>
                <td>
                    <div class="form-check form-switch mb-0">
                        <input form="@formId" class="form-check-input" type="checkbox" role="switch"
                               id="captureUrlVisits-@device.DeviceId" name="captureUrlVisits" value="true"
                               checked="@device.CaptureUrlVisits" />
                    </div>
                    <input form="@formId" type="hidden" name="captureUrlVisits" value="false" />
                </td>
                <td>
                    <div class="form-check form-switch mb-0">
                        <input form="@formId" class="form-check-input" type="checkbox" role="switch"
                               id="captureIdle-@device.DeviceId" name="captureIdle" value="true"
                               checked="@device.CaptureIdle" />
                    </div>
                    <input form="@formId" type="hidden" name="captureIdle" value="false" />
                </td>
                <td>
                    <div class="form-check form-switch mb-0">
                        <input form="@formId" class="form-check-input" type="checkbox" role="switch"
                               id="captureSessionBreaks-@device.DeviceId" name="captureSessionBreaks" value="true"
                               checked="@device.CaptureSessionBreaks" />
                    </div>
                    <input form="@formId" type="hidden" name="captureSessionBreaks" value="false" />
                </td>
                <td>
                    <div class="form-check form-switch mb-0">
                        <input form="@formId" class="form-check-input" type="checkbox" role="switch"
                               id="captureScreenshots-@device.DeviceId" name="captureScreenshots" value="true"
                               checked="@device.CaptureScreenshots" />
                    </div>
                    <input form="@formId" type="hidden" name="captureScreenshots" value="false" />
                </td>
                <td>
                    <select form="@formId" class="form-select form-select-sm" style="width:auto"
                            name="screenshotIntervalMinutes" aria-label="Screenshot frequency for @device.MachineName">
                        @foreach (var minutes in TimeTracker.Shared.Devices.DeviceCapturePolicyDto.ScreenshotIntervalChoices
                            .Append(device.ScreenshotIntervalMinutes).Distinct().Order())
                        {
                            <option value="@minutes" selected="@(minutes == device.ScreenshotIntervalMinutes)">
                                Every @(minutes >= 60 && minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes} min")
                            </option>
                        }
                    </select>
                </td>
                <td class="text-nowrap">
                    <button form="@formId" type="submit" class="btn btn-sm btn-primary">Save</button>
                    <button form="pin-@device.DeviceId" type="submit" class="btn btn-sm btn-link p-0 ms-2 align-baseline"
                            title="@(device.IsPinned ? "Unpin from the top" : "Pin to the top")">
                        @(device.IsPinned ? "Unpin" : "Pin")
                    </button>
                    <button form="delete-@device.DeviceId" type="submit" class="btn btn-sm btn-link p-0 ms-2 align-baseline text-danger"
                            onclick="return confirm('Delete @device.MachineName and permanently erase all of its recorded activity, screenshots and idle time?\n\nThis cannot be undone.');">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
@if (Model.Devices.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">&#128421;</div>
        <div>No devices have synced yet.</div>
    </div>
}
</div>
