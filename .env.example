# Copy to .env and fill in real values. .env is gitignored - never commit it.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# First admin account, created automatically on the server's first startup.
# Must satisfy ASP.NET Core Identity's default password rules: 6+ chars,
# at least one uppercase, one lowercase, one digit, one non-alphanumeric.
# A password that doesn't meet these is silently rejected and NO admin
# account gets created - check `docker compose logs server` if login fails.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=Change-Me-1!

# Shared secret the Windows Agent installer must be given the same value for
# (X-Agent-Key header). Generate something long and random, e.g.:
#   openssl rand -base64 32
AGENT_API_KEY=change-me-long-random-string
